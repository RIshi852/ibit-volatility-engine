\f0\fs24 \cf0 /**\
 * IBIT Volatility Harvesting & Cash Yield Ledger\
 * Target Spreadsheet ID: 1_R3lsppGz27bBpzEbRsm1JqB6MFYNniyIw4qKSg5hFk\
 */\
\
const SPREADSHEET_ID = '1_R3lsppGz27bBpzEbRsm1JqB6MFYNniyIw4qKSg5hFk';\
const SHEET_DASHBOARD = 'Dashboard';\
const SHEET_OPEN = 'Open_Tranches';\
const SHEET_LEDGER = 'Realized_Yield_Ledger';\
\
/**\
 * Initializes and formats all required tabs if absent.\
 */\
function setupSheets() \{\
  const ss = SpreadsheetApp.openById(SPREADSHEET_ID);\
\
  // 1. Open_Tranches\
  let openSheet = ss.getSheetByName(SHEET_OPEN);\
  if (!openSheet) \{\
    openSheet = ss.insertSheet(SHEET_OPEN);\
    openSheet.appendRow([\
      'Tranche ID',\
      'Date Opened',\
      'Tier',\
      'Entry BTC Price',\
      'Deployed Capital ($)',\
      'Target Exit Price',\
      'Status'\
    ]);\
    openSheet.getRange('A1:G1').setFontWeight('bold').setBackground('#1f2937').setFontColor('#ffffff');\
    openSheet.setFrozenRows(1);\
  \}\
\
  // 2. Realized_Yield_Ledger\
  let ledgerSheet = ss.getSheetByName(SHEET_LEDGER);\
  if (!ledgerSheet) \{\
    ledgerSheet = ss.insertSheet(SHEET_LEDGER);\
    ledgerSheet.appendRow([\
      'Tranche ID',\
      'Open Date',\
      'Close Date',\
      'Capital Deployed ($)',\
      'Gross Proceeds ($)',\
      'Net Realized Cash Yield ($)',\
      'Holding Period (Days)'\
    ]);\
    ledgerSheet.getRange('A1:G1').setFontWeight('bold').setBackground('#065f46').setFontColor('#ffffff');\
    ledgerSheet.setFrozenRows(1);\
  \}\
\
  // 3. Dashboard\
  let dashSheet = ss.getSheetByName(SHEET_DASHBOARD);\
  if (!dashSheet) \{\
    dashSheet = ss.insertSheet(SHEET_DASHBOARD, 0);\
    const dashLayout = [\
      ['IBIT VOLATILITY HARVESTING ENGINE - LIVE KPI DASHBOARD', ''],\
      ['Metric', 'Value'],\
      ['Total Realized Cash Yield ($)', '=SUM(Realized_Yield_Ledger!F2:F)'],\
      ['Active Open Tranches Count', '=COUNTA(Open_Tranches!A2:A)'],\
      ['Capital Currently Deployed ($)', '=SUM(Open_Tranches!E2:E)'],\
      ['Average Open Basis (BTC $)', '=IFERROR(SUMPRODUCT(Open_Tranches!D2:D, Open_Tranches!E2:E) / SUM(Open_Tranches!E2:E), 0)'],\
      ['Last Webhook Sync (UTC)', new Date().toISOString()]\
    ];\
    dashSheet.getRange(1, 1, dashLayout.length, 2).setValues(dashLayout);\
    dashSheet.getRange('A1:B1').merge().setFontWeight('bold').setBackground('#111827').setFontColor('#ffffff');\
    dashSheet.getRange('A2:B2').setFontWeight('bold').setBackground('#374151').setFontColor('#ffffff');\
    dashSheet.getRange('B3').setNumberFormat('$#,##0.00');\
    dashSheet.getRange('B4').setNumberFormat('0');\
    dashSheet.getRange('B5:B6').setNumberFormat('$#,##0.00');\
    dashSheet.autoResizeColumns(1, 2);\
  \}\
\
  return \{ ss, dashSheet, openSheet, ledgerSheet \};\
\}\
\
/**\
 * Webhook receiver for TradingView JSON payloads.\
 */\
function doPost(e) \{\
  const lock = LockService.getScriptLock();\
  lock.waitLock(10000); // Prevent race conditions when multiple FIFO tranches exit simultaneously\
\
  try \{\
    if (!e || !e.postData || !e.postData.contents) \{\
      return jsonResponse(\{ status: 'error', message: 'Empty payload' \});\
    \}\
\
    const payload = JSON.parse(e.postData.contents);\
    const \{ dashSheet, openSheet, ledgerSheet \} = setupSheets();\
\
    const eventDate = parseTimestamp(payload.timestamp);\
    const action = String(payload.action).toUpperCase();\
    const trancheId = String(payload.tranche_id);\
    const tier = Number(payload.tier);\
    const capitalUsd = Number(payload.capital_usd);\
    const btcClose = Number(payload.btc_close);\
    const targetExitPrice = Number(payload.target_exit_price);\
\
    if (action === 'BUY') \{\
      openSheet.appendRow([\
        trancheId,\
        eventDate,\
        tier,\
        btcClose,\
        capitalUsd,\
        targetExitPrice,\
        'OPEN'\
      ]);\
      refreshDashboardTimestamp(dashSheet);\
      return jsonResponse(\{ status: 'success', action: 'BUY_LOGGED', tranche_id: trancheId \});\
    \}\
\
    if (action === 'SELL') \{\
      const data = openSheet.getDataRange().getValues();\
      let matchedRowIndex = -1;\
      let rowData = null;\
\
      // Locate matching Tranche ID (FIFO order top-down)\
      for (let i = 1; i < data.length; i++) \{\
        if (String(data[i][0]) === trancheId) \{\
          matchedRowIndex = i + 1; // 1-based sheet row index\
          rowData = data[i];\
          break;\
        \}\
      \}\
\
      if (matchedRowIndex === -1) \{\
        return jsonResponse(\{ status: 'error', message: `Tranche ID $\{trancheId\} not found in Open_Tranches` \});\
      \}\
\
      const openDate = new Date(rowData[1]);\
      const entryBtcPrice = Number(rowData[3]);\
      const deployedCap = Number(rowData[4]);\
\
      // Calculate performance & hold period\
      const grossProceeds = deployedCap * (btcClose / entryBtcPrice);\
      const netRealizedYield = grossProceeds - deployedCap;\
      const msPerDay = 1000 * 60 * 60 * 24;\
      const holdingDays = Math.max(1, Math.round((eventDate.getTime() - openDate.getTime()) / msPerDay));\
\
      // 1. Append to Realized_Yield_Ledger\
      ledgerSheet.appendRow([\
        trancheId,\
        openDate,\
        eventDate,\
        deployedCap,\
        grossProceeds,\
        netRealizedYield,\
        holdingDays\
      ]);\
\
      // 2. Delete closed lot from Open_Tranches\
      openSheet.deleteRow(matchedRowIndex);\
\
      // 3. Refresh Dashboard KPIs & timestamp\
      refreshDashboardTimestamp(dashSheet);\
\
      return jsonResponse(\{\
        status: 'success',\
        action: 'SELL_HARVESTED',\
        tranche_id: trancheId,\
        net_yield_usd: netRealizedYield.toFixed(2),\
        holding_days: holdingDays\
      \});\
    \}\
\
    return jsonResponse(\{ status: 'error', message: `Unsupported action: $\{action\}` \});\
\
  \} catch (err) \{\
    return jsonResponse(\{ status: 'error', message: err.toString() \});\
  \} finally \{\
    lock.releaseLock();\
  \}\
\}\
\
/**\
 * Helper: Converts TradingView \{\{time\}\} (epoch ms or ISO string) into a JS Date object.\
 */\
function parseTimestamp(ts) \{\
  if (!ts) return new Date();\
  const num = Number(ts);\
  if (!isNaN(num) && num > 1000000000) \{\
    // Handle both seconds and milliseconds epoch timestamps\
    return new Date(num < 100000000000 ? num * 1000 : num);\
  \}\
  const parsed = new Date(ts);\
  return isNaN(parsed.getTime()) ? new Date() : parsed;\
\}\
\
/**\
 * Helper: Updates Dashboard sync timestamp and forces formula recalculation.\
 */\
function refreshDashboardTimestamp(dashSheet) \{\
  dashSheet.getRange('B7').setValue(new Date().toISOString());\
  SpreadsheetApp.flush();\
\}\
\
/**\
 * Helper: Returns HTTP 200 JSON ContentService output.\
 */\
function jsonResponse(obj) \{\
  return ContentService.createTextOutput(JSON.stringify(obj))\
    .setMimeType(ContentService.MimeType.JSON);\
\}}